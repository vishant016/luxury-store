# Set to your Railway backend public URL (no trailing slash)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-backend.up.railway.app

# Publishable API key from Medusa seed output or Admin dashboard
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Default display currency (inr, usd, eur)
NEXT_PUBLIC_STORE_CURRENCY=inr

# Cloudflare R2 public URL — set once you configure R2 (Section 8 of DEVOPS.md)
# This allows Next.js Image Optimization to serve R2-hosted product images
NEXT_PUBLIC_R2_FILE_URL=https://pub-xxxxxxxx.r2.dev
